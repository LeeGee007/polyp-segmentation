[MASTER]
ignore = .venv,__pycache__,.git,node_modules,dist,build,*.egg-info
ignore-patterns =
jobs = 0
persistent = yes
fail-under = 8.0


[MESSAGES CONTROL]
disable =
    missing-module-docstring,
    missing-class-docstring,
    missing-function-docstring,
    line-too-long,
    too-many-lines,
    too-many-arguments,
    too-many-locals,
    too-many-branches,
    too-many-statements,
    too-many-instance-attributes,
    too-few-public-methods,
    too-many-public-methods,
    invalid-name,
    unused-argument,
    unused-variable,
    wrong-import-order,
    wrong-import-position,
    ungrouped-imports,
    unused-import,
    duplicate-code,
    protected-access,
    too-many-positional-arguments,


[FORMAT]
max-line-length = 120
indent-string = '    '
max-module-lines = 1000


[BASIC]
module-rgx =(([a-z_][a-z0-9_]*)|([A-Z][a-zA-Z0-9]*))$
const-rgx = ([A-Z_][A-Z0-9_]*)$
class-rgx = ([A-Z_][a-zA-Z0-9]*)$
function-rgx = ([a-z_][a-z0-9_]*)$
argument-rgx = ([a-z_][a-z0-9_]*)$
variable-rgx = ([a-z_][a-z0-9_]*)$
attr-rgx = ([a-z_][a-z0-9_]*)$


[SIMILARITIES]
min-similarity-lines = 6
ignore-comments = yes
ignore-docstrings = yes
ignore-imports = yes


[DESIGN]
max-args = 8
max-locals = 20
max-branches = 15
max-statements = 60
max-attributes = 12
max-public-methods = 25


[VARIABLES]
dummy-variables-rgx = (_+[a-zA-Z0-9]*$)|(_$)


[TYPECHECK]
ignored-modules =
ignored-classes =
generated-members =


[IMPORTS]
allow-wildcard-with-all = no


[CLASSES]
exclude-protected = _asdict,_fields,_replace,_source,_make


[EXCEPTIONS]
overgeneral-exceptions = builtins.BaseException,builtins.Exception